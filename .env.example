# Copie para `.env` e ajuste. Nunca coloque valores reais neste arquivo.
# Docs: docs/03-requisitos-nao-funcionais.md (RNF-OPS-03, RNF-SEG-06)

NODE_ENV=development
LOG_LEVEL=info

# Conexão da aplicação (usuário com privilégios mínimos; em produção, via pooler).
DATABASE_URL=postgresql://pdv_app:change-me@localhost:54329/pdv
# Conexão do dono do schema, usada SÓ nas migrações (CLI do Prisma). Opcional no servidor:
# em produção não coloque esta credencial no ambiente da aplicação.
DIRECT_URL=postgresql://pdv_owner:change-me@localhost:54329/pdv

# Banco dos testes de integração.
TEST_DATABASE_URL=postgresql://pdv_app:change-me@localhost:54329/pdv_test
TEST_DIRECT_URL=postgresql://pdv_owner:change-me@localhost:54329/pdv_test
