// Prisma 7: a URL de conexão vive em prisma.config.ts, não aqui.
//
// Convenções (docs/05): tabelas e colunas em snake_case (via @map/@@map), ids `uuid` gerados
// pela aplicação (IdGenerator injetável), datas `timestamptz` em UTC e preenchidas com o
// `Clock` injetável (por isso sem @updatedAt). CHECKs, REVOKEs e índices que o Prisma não
// expressa ficam em SQL manual dentro da migração.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @db.Uuid
  name           String
  /// Normalizado (trim + minúsculas); o CHECK da migração garante isso no banco.
  email          String    @unique
  passwordHash   String    @map("password_hash")
  /// Hoje só `OWNER` (CHECK na migração). Campo existe para evolução futura (RN-ACE-01).
  role           String    @default("OWNER")
  active         Boolean   @default(true)
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  sessions  Session[]
  auditLogs AuditLog[]

  @@map("users")
}

model Session {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// SHA-256 (hex) do token; o token em claro só existe no cookie do navegador.
  tokenHash String   @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("sessions")
}

/// Append-only: a migração revoga UPDATE/DELETE/TRUNCATE do papel da aplicação (RN-ACE-03).
/// `data` nunca contém dado pessoal (RNF-LGPD-05).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  data       Json     @default("{}") @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

/// Categorias editáveis (RN-CAT-07). Só se exclui categoria vazia: FK RESTRICT em `products`.
model Category {
  id             String   @id @db.Uuid
  name           String
  /// Gerado pela aplicação (`normalizeText`); único. O CHECK da migração exige não vazio.
  nameNormalized String   @unique @map("name_normalized")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("categories")
}

/// Produtos nunca são excluídos: arquivam (RN-CAT-04); a migração revoga DELETE do `pdv_app`.
/// CHECKs (preço/custo/estoque ≥ 0, nome 1–120, formatos fiscais), o índice ÚNICO PARCIAL do nome
/// entre ativos (RN-CAT-02) e o GIN trigram (ADR-020) ficam em SQL manual na migração.
/// `stockQty` é cache: só o módulo `inventory` (M3) o escreve (ADR-007).
model Product {
  id             String    @id @db.Uuid
  name           String
  nameNormalized String    @map("name_normalized")
  /// Opcional; único entre TODOS os produtos, inclusive arquivados (RN-CAT-03).
  barcode        String?   @unique
  categoryId     String?   @map("category_id") @db.Uuid
  priceCents     Int       @map("price_cents")
  costCents      Int?      @map("cost_cents")
  stockQty       Int       @default(0) @map("stock_qty")
  minStock       Int       @default(0) @map("min_stock")
  /// Chave no armazenamento de arquivos (foto: M10).
  photoKey       String?   @map("photo_key")
  ncm            String?   @db.Char(8)
  cest           String?   @db.Char(7)
  cfop           String?   @db.Char(4)
  csosn          String?   @db.Char(3)
  origin         Int?      @db.SmallInt
  unit           String    @default("UN") @db.Char(2)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  category Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@map("products")
}

/// Serviços não têm estoque nem custo (RN-SER-05/07). No máximo UMA taxa de deslocamento
/// (índice único parcial na migração, RN-SER-03). Nunca excluídos: arquivam (RN-CAT-04).
model Service {
  id                String    @id @db.Uuid
  name              String
  nameNormalized    String    @map("name_normalized")
  priceCents        Int       @map("price_cents")
  isDisplacementFee Boolean   @default(false) @map("is_displacement_fee")
  fiscalServiceCode String?   @map("fiscal_service_code")
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("services")
}
